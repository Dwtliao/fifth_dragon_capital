# E*TRADE API credentials (from https://developer.etrade.com)
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=

# true = sandbox (apisb.etrade.com), false = production (api.etrade.com)
ETRADE_DEV=true

# OAuth token file (created automatically after `python -m etrade_sync auth`)
ETRADE_TOKEN_FILE=~/.config/etrade/tokens.json

# Postgres connection string
DATABASE_URL=postgresql://postgres@localhost:5432/davidliao

# Claude journal extraction and model testing
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_JOURNAL_EFFORT=low
# Market interpretation runs on brief generation, independently of journal sync.
CLAUDE_BRIEF_EFFORT=medium
CLAUDE_BRIEF_ANALYSIS=true
# Opt in to sending current holdings and saved levels to Anthropic for analysis.
CLAUDE_BRIEF_INCLUDE_PORTFOLIO=false
